{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended"
  ],
  "schedule": [
    "after 9am and before 9pm"
  ],
  "timezone": "Europe/Vilnius",
  "minimumReleaseAge": "7 days",
  "internalChecksFilter": "strict",
  "pinDigests": true,
  "vulnerabilityAlerts": {
    "minimumReleaseAge": null
  },
  "packageRules": [
    {
      "description": "Group GitHub Actions updates into a single PR",
      "matchManagers": [
        "github-actions"
      ],
      "groupName": "github actions"
    },
    {
      "description": "Group the MkDocs toolchain into a single PR",
      "matchManagers": [
        "pip_requirements"
      ],
      "groupName": "mkdocs toolchain"
    }
  ]
}
